#-# mode: category
#-# ordered: true

# Composition of 2-cells
coh co2 (a b : .) (f g h : a → b) (α : f → g) (β : g → h) : f → h

# This one is morally fine but not accepted because we do not declare variables
# in the right order
ncoh co2' (a b : .) (f g h : a → b) (β : g → h) (α : f → g) : f → h

# Unary composition of 2-cells
coh self {a b : .} {f g : a → b} (α : f → g) : f → g

# This one is wrong (h is there)
ncoh self-bad {a b : .} {f g h : a → b} (α : f → g) : f → g

# This one is wrong in an oriented setting
ncoh sym (a b : .) (f g : a → b) (α : f → g) : g → f

# Basic test
coh co {a b c : .} (f : a → b) (g : b → c) : a → c
coh assoc {a b c d : .} (f : a → b) (g : b → c) (h : c → d) : co (co f g) h = co f (co g h)

# We cannot weaken 2-cells
ncoh wk {a b : .} {f g : a → b} (α β : f → g) : f → g
